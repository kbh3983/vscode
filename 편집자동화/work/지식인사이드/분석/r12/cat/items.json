[["오프닝", "자료화면 위 인용", "지갑·지폐 손 자료화면 + 회색 따옴표 + 흰 문장 2줄", 3.5, 0.0], ["오프닝", "오프닝 큰 자막", "흰 큰 굵은 고딕, 화면 아래 (콜드 오픈)", 8.6, 8.0], ["오프닝", "큰 자막 흐림→선명 등장", "흰 큰 굵은 고딕이 흐릿하게 나타나 선명해짐 (콜드 오픈)", 7.7, 7.0], ["타이틀", "지식인 클래스 로고", "갈색 종이 질감 + 로고 + 부제", 24.0, 22.4], ["자료", "자료화면 + 찢어진 종이 테두리", "월급 명세서 장면, 위아래 찢어진 종이 가장자리", 33.0, 31.0], ["이름", "이름 자막 (찢어진 종이)", "흰 종이 띠 이름 + 회색 직함 + 경력 3줄", 49.5, 48.0], ["카드", "Question 카드", "와이드 위 노랑 Question. + 흰·노랑 2줄", 66.5, 65.0], ["카드", "좌상단 소제목 + 이름 태그", "흰 소제목 + 살구 이름 태그 + 주황 세로선", 73.0, 71.0], ["강조", "대괄호 요약 자막", "[ 엄격한 규칙은 도움이 됩니다 ] 흰 고딕, 화면 아래", 76.5, 75.5], ["인용", "와이드 위 왼쪽 인용", "와이드 화면 왼쪽 회색 따옴표 + 흰 문장 2줄", 81.0, 79.5], ["강조", "대괄호 요약 자막 (큰)", "[ 월급의 절반은 쓰고, 절반은 모으자 ] 화면 폭 가득", 92.0, 90.8], ["화면", "좌우 분할 + 주황 세로선", "두 사람 단독 컷을 좌우로 + 가운데 주황선", 107.0, 105.9], ["자막", "속마음 작은 괄호", "(감탄) 작은 흰 손글씨, 진행자 옆", 158.5, 158.0], ["강조", "번호 대괄호 자막", "[1. 청약저축 가입하기] 단계 번호", 184.5, 184.2], ["칠판", "전체 칠판 수식", "150만 원 > 연금 저축 10~20만 원 (한 자씩 타이핑)", 241.0, 239.3], ["칠판", "전체 칠판 수식 (줄 추가)", "ISA 130만 원 저금이 아래에 추가", 256.0, 252.0], ["자막", "리액션 큰 자막", "그게 좋지 않은 선택이죠 — 흰 큰 글자", 318.0, 317.0], ["칠판", "칠판 라벨 3개", "사회 초년생 계좌 개설 팁 + 살구 라벨 3개", 479.0, 476.0], ["칠판", "찢어진 칠판 반쪽 + 체크 단계", "굵은 외곽선 제목 + 빨간 체크박스 1~3 step", 554.5, 550.5], ["카드", "와이드 위 설명 카드", "KRX 금현물 계좌 제목 + 설명 3줄", 624.0, 622.5], ["칠판", "칠판 목록 (라벨 늘어남)", "완성형 계좌 목록 — 살구 라벨 6개 차례로, 마지막 흰", 748.0, 730.0], ["자료", "차트 화면 자료", "주식 차트 모니터 자료화면, 어둡게", 812.0, 811.0], ["자막", "말풍선형 이모티콘 자막", "박곰희 TV 보셨나요? — 얼굴 아이콘 + 흰 자막", 1082.0, 1081.0], ["칠판", "칠판 등식", "ISA = 현금화 가능 / 저축연금 = … / IRP = …", 1283.5, 1276.0], ["인용", "인물 사진 위 인용", "버핏 사진 + 위아래 찢어진 종이 + 따옴표 문장", 1340.0, 1337.0], ["강조", "와이드 위 대괄호 자막", "[ MMW 비대면 개설 X ] 와이드 화면에도 같은 모양", 1040.5, 1039.5], ["엔딩", "엔드카드", "검은 질감 + 주황 지식 인사이드.", 1545.0, 1541.5], ["자막", "기본 하단 자막", "가운데 아래 흰 글자 + 검정 상자", 130.0, 129.5]]